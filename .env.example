# =========================================================
# .env.example — Plataforma Inteligente de Emergencias Vehiculares
# Ciclo 1 — Copia este archivo como .env y personaliza
# =========================================================

# --- PostgreSQL ---
POSTGRES_USER=emergencias_user
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_DB=emergencias_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend FastAPI ---
SECRET_KEY=cambiar_por_una_clave_segura_256_bits
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (Frontend Angular) ---
CORS_ORIGINS=http://localhost:4200,http://localhost:80

# --- Entorno ---
ENVIRONMENT=development
DEBUG=true

# --- Backend URL para frontends ---
BACKEND_URL=http://localhost:8000
# Prefijo de la API
API_PREFIX=/api
