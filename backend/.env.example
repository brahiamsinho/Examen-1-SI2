# =========================================================
# Preferir .env en la RAÍZ del repositorio (una sola fuente).
# Este archivo solo si ejecutas uvicorn solo desde backend/ sin variables globales.
# =========================================================

DATABASE_URL=postgresql+asyncpg://emergencias_user:cambiar_en_produccion@localhost:5432/emergencias_db

SECRET_KEY=cambiar_por_una_clave_segura_256_bits
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:4200,http://localhost:80
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# Seed admin (opcional; ver .env raíz). python -m app.seeds ignora SEED_ADMIN_ON_START.
SEED_ADMIN_ON_START=false
SEED_ADMIN_EMAIL=adm@test.com
SEED_ADMIN_PASSWORD=adm123
SEED_ADMIN_TELEFONO=+5917000001
SEED_ADMIN_NOMBRES=Administrador
SEED_ADMIN_APELLIDOS=Sistema
SEED_ADMIN_USERNAME=admin

# Seed cliente / taller (ver .env.example en la raíz del repo para el listado completo)
SEED_CLIENTE_ON_START=false
SEED_CLIENTE_EMAIL=cli@test.com
SEED_CLIENTE_PASSWORD=cli123
SEED_CLIENTE_TELEFONO=+5917000002
SEED_TALLER_ON_START=false
SEED_TALLER_EMAIL=taller@test.com
SEED_TALLER_PASSWORD=taller123
SEED_TALLER_TELEFONO=+5917000003
SEED_TECNICO_ON_START=false
SEED_TECNICO_EMAIL=tec@test.com
SEED_TECNICO_PASSWORD=tec123
SEED_TECNICO_TELEFONO=+5917000004

# Firebase Cloud Messaging (CU19). Ruta al JSON de cuenta de servicio (no commitear secretos).
FCM_ENABLED=false
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Pagos CU20: con true el cobro simulado confirma en el mismo POST; false = flujo en 2 pasos.
PAGO_SIMULADO_AUTOCOMPLETE=true
PAGO_PROVEEDOR_DEFAULT=SIMULADO
# Stripe (opcional). No uses la variable SECRET_KEY del JWT para Stripe: nombres dedicados.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
